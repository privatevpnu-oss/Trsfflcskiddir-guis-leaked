						remote:InvokeServer("CreateTextures", {{Part=data.new, Face=v.Face, TextureType="Decal"}})
						remote:InvokeServer("SyncTexture", {{Part=data.new, Face=v.Face, TextureType="Decal", Texture=v.Texture, Transparency=v.Transparency}})
					end
				end
			end
		end
	
