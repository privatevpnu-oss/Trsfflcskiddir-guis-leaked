						entry.Range = lightObj.Range
						entry.Face = lightObj.Face
						entry.Angle = lightObj.Angle
						entry.Shadows = lightObj.Shadows
					end
					table.insert(lightsData, entry)
				end
			end
			if #lightsData > 0 then
